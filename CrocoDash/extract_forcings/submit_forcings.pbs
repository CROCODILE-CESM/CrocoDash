#!/bin/bash -e
#
# PBS batch submission script for CrocoDash forcing extraction.
#
# Submit with:
#   qsub submit_forcings.pbs
#
# Customize the PBS directives below for your allocation, and the
# `crocodash process` invocation for which components to run.
# See `crocodash process --help` for the full list of component flags.
#
# ---------------------------------------------------------------------
# COMMON CONFIGURATIONS
#
# 1. All components:
#      crocodash process --caseroot <caseroot> --all
#
# 2. OBC only:
#      crocodash process --caseroot <caseroot> --bc
#
# 3. All components, skip tides:
#      crocodash process --caseroot <caseroot> --all --skip tides
# ---------------------------------------------------------------------

# --- Required: set your project/account code ---
#PBS -A <YOUR_PROJECT_CODE>

# --- Job settings ---
#PBS -N crocodash_forcings
#PBS -j oe
#PBS -S /bin/bash
#PBS -q main
#PBS -l walltime=06:00:00
#PBS -l select=1:ncpus=1:mpiprocs=1:ompthreads=1:mem=50GB

# Change to the directory where qsub was run
cd "$PBS_O_WORKDIR"

# Activate the CrocoDash conda environment
source ~/.bash_profile
module load conda
conda activate CrocoDash

# Run all components for the case at <caseroot>
crocodash process --caseroot <caseroot> --all
